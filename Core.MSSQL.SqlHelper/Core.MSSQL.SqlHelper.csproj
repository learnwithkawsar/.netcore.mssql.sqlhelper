<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>2.0.0</Version>
    <Authors>Kawsar Ahmed</Authors>
    <Description>Easy-to-use helpers for common operations on Microsoft SQL Server (DataTable/DataSet/Scalar/NonQuery, stored procedures, sync and async), with ASP.NET Core dependency injection support.</Description>
    <Copyright>2019-2026 Kawsar Ahmed</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sql;mssql;sqlserver;microsoft;helper;aspnetcore;dotnet;ado.net</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/learnwithkawsar/.netcore.mssql.sqlhelper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.MSSQL.SqlHelper.Tests" />
  </ItemGroup>

</Project>
